# Copy to `.env.local` for local development. And please, if you decide to vibe code, don't commit real secrets ;)

# --- Supabase (server-only; required for API routes) ---
# Project URL from Supabase Dashboard
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — server-only. Grants full access to Postgres and Storage.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Public ---
# Where consent links and the data-handling section point. Use a full URL in
# production, or leave unset to default to `/research/overview`.
NEXT_PUBLIC_INFO_URL=http://localhost:3000/research/overview

# --- Submission API (server-only) ---
# Comma-separated browser origins allowed to call submission API routes, in
# addition to the deployment's own origin. Required for cross-origin setups.
ALLOWED_ORIGINS=http://localhost:3000

# Maximum gzipped payload size (bytes) accepted at init. Default in code: 49000000. Bounded by the Supabase plan.
SUBMISSION_MAX_BYTES=49000000

# Length in bytes of newly generated withdrawal tokens before base64url encoding.
# Default in code: 32.
WITHDRAWAL_TOKEN_BYTES=32
